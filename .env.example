# Supabase project settings (Project Settings > API in the Supabase dashboard)
# Prefixed with EXPO_PUBLIC_ so Expo bundles these into the client app.
# Safe to expose client-side ONLY because Row-Level Security + policies gate access.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon/public key — kept as a fallback only in case the installed
# supabase-js version doesn't yet support the newer publishable-key format.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never add the `secret` key (service_role equivalent) here or anywhere in
# this mobile app's env — it bypasses RLS and must stay server-side only.
# This project has no server-side component that would need it.

# ---------------------------------------------------------------------------
# Local development
#
# `.env` points at the hosted project. To develop against the local Supabase
# stack instead, create `.env.local` — Expo loads it at higher precedence, and
# `jest.setup.js` makes the RLS suite follow. Renaming it returns to hosted.
#
# Take the values from `npx supabase status`, but substitute your LAN IP for
# 127.0.0.1: the app runs in Expo Go on a physical phone, which cannot reach
# your machine's loopback address.
#
#   EXPO_PUBLIC_SUPABASE_URL=http://192.168.x.x:54321
#   EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<anon key from `supabase status`>
#
# The local anon key is a fixed development credential for a database only
# reachable on your machine. It is not a secret, and it is not the same thing
# as the `secret` key warned about above.
# ---------------------------------------------------------------------------
