# Supabase project settings (Project Settings > API in the Supabase dashboard)
# Prefixed with EXPO_PUBLIC_ so Expo bundles these into the client app.
# Safe to expose client-side ONLY because Row-Level Security + policies gate access.

EXPO_PUBLIC_SUPABASE_URL=
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Legacy anon/public key — kept as a fallback only in case the installed
# supabase-js version doesn't yet support the newer publishable-key format.
EXPO_PUBLIC_SUPABASE_ANON_KEY=

# Never add the `secret` key (service_role equivalent) here or anywhere in
# this mobile app's env — it bypasses RLS and must stay server-side only.
# This project has no server-side component that would need it.
